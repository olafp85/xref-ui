{
  "name": "xref",
  "version": "0.0.1",
  "private": true,
  "description": "Xref SAPUI5 frontend",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sap/ux-ui5-tooling": "^1.34.0",
    "@sapui5/types": "~1.148.13",
    "@types/cytoscape": "^3.21.9",
    "@ui5/cli": "^4.0.73",
    "eslint": "^9.39.5",
    "ftp-deploy": "^2.4.7",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "ui5-tooling-transpile": "^3.14.1"
  },
  "scripts": {
    "start": "fiori run --open \"index.html?sap-ui-xx-viewCache=false&sap-ui-xx-componentPreload=off\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "deploy": "npm run build && node deploy",
    "deploy-config": "fiori add deploy-config",
    "unit-tests": "fiori run --open 'test/unit/unitTests.qunit.html'",
    "int-tests": "fiori run --open 'test/integration/opaTests.qunit.html'",
    "lint": "eslint webapp",
    "ts-typecheck": "tsc --noEmit"
  },
  "ui5": {
    "dependencies": [
      "@sap/ux-ui5-tooling",
      "ui5-tooling-transpile"
    ]
  },
  "sapuxLayer": "CUSTOMER_BASE"
}
