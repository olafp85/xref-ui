{
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "strict": true,
        "strictPropertyInitialization": false,
        "noEmit": true,
        "rootDir": "./webapp",
        "types": [
            "@sapui5/types",
            "@types/cytoscape"
        ],
        "paths": {
            "xref/*": [
                "./webapp/*"
            ]
        }
    },
    "include": [
        "webapp/**/*"
    ],
    "exclude": [
        "webapp/test/**/*"
    ]
}
